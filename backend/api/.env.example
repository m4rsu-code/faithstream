APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"
ADMIN_EMAILS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=faithstream
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# One-time license payments stay closed during FaithStream Studio's free launch period.
# When the free period has ended and you are ready, set LICENSE_SALES_ENABLED=true,
# set LICENSE_SALES_STARTS_AT to a date after the free period, and configure the price and QR details.
LICENSE_SALES_ENABLED=false
LICENSE_REQUIRED=false
LICENSE_SALES_STARTS_AT=
LICENSE_PRICE=0
LICENSE_CURRENCY=PHP
# QR image URLs must point to public image files. Never put payment PINs, passwords, or OTPs here.
LICENSE_GCASH_RECIPIENT=
LICENSE_GCASH_ACCOUNT=
LICENSE_GCASH_QR_URL=
LICENSE_GOTYME_RECIPIENT=
LICENSE_GOTYME_ACCOUNT=
LICENSE_GOTYME_QR_URL=
LICENSE_MARIBANK_RECIPIENT=
LICENSE_MARIBANK_ACCOUNT=
LICENSE_MARIBANK_QR_URL=

# This will be the link for verfication emails sent to users. It should be the same as the APP_URL above.
# To send mail through your verified Gmail sender, set these in your private .env file:
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-verified-sender@gmail.com
# MAIL_PASSWORD=your-google-app-password
# MAIL_FROM_ADDRESS=your-verified-sender@gmail.com
# MAIL_FROM_NAME="FaithStream Studio"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
