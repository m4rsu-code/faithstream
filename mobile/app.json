{
  "expo": {
    "name": "FaithStream Cam",
    "slug": "faithstream-cam",
    "version": "1.0.1",
    "android": {
      "versionCode": 2,
      "package": "com.anonymous.faithstreamcam",
      "adaptiveIcon": {
        "foregroundImage": "./assets/camera-launcher-icon.png",
        "backgroundColor": "#0b1b28"
      },
      "permissions": ["CAMERA", "INTERNET", "RECORD_AUDIO", "REQUEST_INSTALL_PACKAGES"],
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "orientation": "default",
    "icon": "./assets/camera-launcher-icon.png",
    "splash": {
      "image": "./assets/faithstream-adaptive-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1b28"
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-dev-client",
      "./plugins/withApkInstaller",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FaithStream Cam to scan Studio pairing QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow FaithStream Cam to use your camera.",
          "microphonePermission": "Allow FaithStream Cam to use your microphone."
        }
      ]
    ]
  }
}
