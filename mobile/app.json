{
  "expo": {
    "name": "FaithStream Cam",
    "slug": "faithstream-cam",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/faithstream-app-icon.png",
    "splash": {
      "image": "./assets/faithstream-adaptive-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1b28"
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-dev-client",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow FaithStream Cam to use your camera.",
          "microphonePermission": "Allow FaithStream Cam to use your microphone."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "FaithStream Cam connects to FaithStream Studio on your local Wi-Fi network."
      }
    },
    "android": {
      "package": "com.anonymous.faithstreamcam",
      "adaptiveIcon": {
        "foregroundImage": "./assets/faithstream-adaptive-foreground.png",
        "backgroundColor": "#0b1b28"
      },
      "permissions": ["CAMERA", "INTERNET"],
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize"
    }
  }
}
